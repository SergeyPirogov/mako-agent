# Only the variables for the trackers you use are required.

# Jira Cloud: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# GitHub: optional if `gh auth login` is done (the CLI token is used)
GITHUB_TOKEN=

# GitLab: personal access token with the `api` scope
GITLAB_TOKEN=
