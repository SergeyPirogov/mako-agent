{
  "name": "mako-agent",
  "version": "0.2.0",
  "description": "Watches Jira, GitHub and GitLab for tasks and hands them to your AI agent, with a menu bar app",
  "type": "module",
  "bin": {
    "mako": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "app": "tsc && electron .",
    "app:build": "tsc && electron-builder --dir",
    "app:dmg": "tsc && electron-builder --mac dmg",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-notifier": "^8.0.5",
    "@types/ws": "^8.18.2",
    "electron": "^44.10.0",
    "electron-builder": "26.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^15.0.12",
    "node-notifier": "^10.0.1",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "main": "dist/desktop.js",
  "build": {
    "appId": "dev.mako.desktop",
    "productName": "Mako",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/node-pty/build/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSUserNotificationAlertStyle": "alert"
      },
      "artifactName": "Mako-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    }
  }
}
