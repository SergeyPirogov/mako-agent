{
  "agentLanguage": "uk",
  "stateDir": ".mako",
  "projectsDir": "~/mako/projects",
  "pollIntervalSec": 60,
  "wipLimit": 2,
  "wipAuto": false,
  "limitPausePct": 85,
  "archiveAfterDays": 2,
  "keepAwake": true,
  "branchPattern": "{type}/{id}-{title}",
  "notifications": {
    "enabled": true,
    "autoTake": false,
    "autoTakeOnly": "all",
    "snoozeMin": 60,
    "inboxPort": 7777,
    "morningDigest": "09:00",
    "awayHours": 4,
    "events": {
      "newTask": true
    }
  },
  "comments": {
    "onStart": {
      "en": "Took the task. Branch {branch}. I'll open an MR once it's ready.",
      "uk": "Взяв задачу в роботу. Гілка {branch}. Як буде готово, відкрию MR."
    },
    "onReview": {
      "en": "Opened an MR: {mr}",
      "uk": "Відкрив MR: {mr}"
    }
  },
  "estimate": {
    "enabled": true,
    "useModel": true
  },
  "codeAsk": {
    "model": "haiku"
  },
  "agentReview": {
    "model": "",
    "comments": "mr",
    "lessonTasks": 3,
    "lessonDays": 90
  },
  "routes": {
    "mode": "balanced",
    "table": {
      "work": {
        "big": { "model": "opus", "effort": "high" }
      }
    },
    "prices": {
      "opus": { "input": 4, "output": 20, "cacheRead": 0.2, "cacheCreate": 8 }
    }
  },
  "executors": {
    "terminal": {
      "type": "terminal",
      "command": "claude",
      "permissionMode": "auto",
      "allowedTools": ["Bash(git:*)", "Bash(npm:*)", "WebFetch"],
      "setupCommand": "",
      "view": "chat",
      "autoFix": false,
      "autoRebase": "rebase",
      "rebaseEveryMin": 30,
      "planFirst": "never",
      "checkTimeoutSec": 600,
      "checkAttempts": 3
    },
    "orca": {
      "type": "orca",
      "command": "orca",
      "agent": "claude",
      "setup": "inherit",
      "linkIssue": true,
      "instructions": {
        "en": "Open an MR into {baseBranch} when the work on {taskId} is done.",
        "uk": "Коли роботу над {taskId} буде завершено, відкрий MR у {baseBranch}."
      },
      "mrBy": "agent",
      "summaryComment": false,
      "extraArgs": []
    }
  },
  "defaultExecutor": "terminal",
  "trackers": [
    {
      "type": "jira",
      "id": "jira",
      "baseUrl": "https://acme.atlassian.net",
      "jql": "assignee = currentUser() AND labels = claude-agent AND statusCategory = \"To Do\" ORDER BY priority DESC",
      "labels": {
        "trigger": null
      },
      "assignee": "",
      "allProjects": false,
      "assignOnTake": true,
      "skipOthersTasks": true,
      "paused": false,
      "transitions": {
        "onStart": "In Progress",
        "onSuccess": "In Review",
        "onFailure": null,
        "onMerged": "Done"
      },
      "projects": {
        "PROJ": {
          "default": "backend",
          "repos": {
            "backend": {
              "repoPath": "/Users/me/code/backend",
              "cloneUrl": "git@github.com:acme/backend.git",
              "baseBranch": "main",
              "setup": "npm install",
              "branchPattern": "{type}/{id}-{title}",
              "checks": ["npm run lint", "npm test"],
              "routeMode": "quality"
            },
            "web": {
              "repoPath": "/Users/me/code/web",
              "baseBranch": "main"
            }
          }
        }
      }
    },
    {
      "type": "github",
      "id": "github",
      "apiUrl": "https://api.github.com",
      "labels": {
        "trigger": "claude-agent"
      },
      "reviewRequests": true,
      "projects": {
        "my-org/web": {
          "repoPath": "/Users/me/code/web",
          "baseBranch": "main",
          "watch": {
            "ci": true,
            "security": true,
            "autoTake": false,
            "maxCost": 5
          },
          "routines": [
            {
              "cron": "0 9 * * 1",
              "title": "Update dependencies",
              "body": "Update the outdated dependencies, run the tests, open an MR.",
              "autoTake": true
            }
          ]
        }
      }
    },
    {
      "type": "gitlab",
      "id": "gitlab",
      "baseUrl": "https://gitlab.com",
      "labels": {
        "trigger": "claude-agent"
      },
      "reviewRequests": true,
      "projects": {
        "my-group/mobile-app": {
          "repoPath": "/Users/me/code/mobile-app",
          "baseBranch": "develop"
        }
      },
      "transitions": {
        "onStart": "In progress",
        "onSuccess": "In review",
        "onFailure": null
      }
    }
  ]
}
