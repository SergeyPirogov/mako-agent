{
  "pollIntervalSec": 60,
  "wipLimit": 2,
  "limitPausePct": 85,
  "maxConcurrent": 2,
  "taskTimeoutMin": 45,
  "handoffCheckMin": 5,
  "stateDir": ".mako",
  "branchPattern": "{type}/{id}-{title}",
  "notifications": {
    "enabled": true,
    "autoTake": false,
    "snoozeMin": 60,
    "morningDigest": "09:00",
    "awayHours": 4,
    "timeoutSec": 600,
    "inboxPort": 7777
  },
  "agentReview": {
    "enabled": false,
    "maxRounds": 1,
    "when": "always"
  },
  "executors": {
    "terminal": {
      "type": "terminal",
      "command": "claude"
    },
    "claude": {
      "type": "claude-headless",
      "command": "claude",
      "args": [
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Bash(git:*) Bash(npm:*) Bash(npx:*) Bash(node:*) Bash(pnpm:*) Bash(yarn:*) Bash(bun:*) Read Edit Write Glob Grep",
        "--max-turns",
        "80"
      ]
    },
    "orca": {
      "type": "orca",
      "agent": "claude",
      "setup": "inherit"
    },
    "codex": {
      "type": "command",
      "label": "Codex",
      "mode": "managed",
      "command": "codex",
      "args": [
        "exec",
        "--full-auto",
        "{prompt}"
      ]
    },
    "tmux": {
      "type": "command",
      "label": "tmux",
      "mode": "handoff",
      "command": "tmux",
      "args": [
        "new-window",
        "-n",
        "{slug}",
        "-c",
        "{worktree}",
        "claude",
        "{prompt}"
      ]
    }
  },
  "defaultExecutor": "terminal",
  "trackers": [
    {
      "type": "jira",
      "jql": "assignee = currentUser() AND labels = claude-agent AND statusCategory = \"To Do\" ORDER BY priority DESC",
      "transitions": {
        "onStart": "In Progress",
        "onSuccess": "In Review",
        "onFailure": null
      },
      "projects": {
        "PROJ": {
          "default": "backend",
          "repos": {
            "backend": {
              "repoPath": "/Users/me/code/backend",
              "baseBranch": "main",
              "match": {
                "components": [
                  "Backend",
                  "API"
                ]
              },
              "extraInstructions": "Run `npm test` before committing."
            },
            "web": {
              "repoPath": "/Users/me/code/web",
              "baseBranch": "main",
              "match": {
                "components": [
                  "Frontend"
                ],
                "labels": [
                  "ui"
                ]
              },
              "executor": "orca"
            }
          }
        }
      }
    },
    {
      "type": "github",
      "labels": {
        "trigger": "claude-agent"
      },
      "projects": {
        "my-org/web": {
          "repoPath": "/Users/me/code/web",
          "baseBranch": "main"
        }
      }
    },
    {
      "type": "gitlab",
      "baseUrl": "https://gitlab.com",
      "labels": {
        "trigger": "claude-agent"
      },
      "projects": {
        "my-group/mobile-app": {
          "repoPath": "/Users/me/code/mobile-app",
          "baseBranch": "develop"
        }
      },
      "transitions": {
        "onStart": "In progress",
        "onSuccess": "In review",
        "onFailure": null
      }
    }
  ]
}
